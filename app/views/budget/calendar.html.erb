<% content_for(:page_heading, "Calendar") %>
<% content_for(:page_icon) do %>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
<% end %>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 mb-5">
  <% income_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: income_icon, tone: :green, label: "Total Income",
        value: usd(@calendar.income_cents), note: pluralize(@calendar.income_days, "income day"), note_tone: :up %>

  <% expense_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: expense_icon, tone: :red, label: "Total Expense",
        value: usd(@calendar.expense_cents), note: pluralize(@calendar.spending_days, "spending day"), note_tone: :down %>

  <% remaining_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13a3 3 0 013 3v5a3 3 0 01-3 3H6a2 2 0 01-2-2z"/><path d="M4 8V7a2 2 0 012-2h9"/><circle cx="16.5" cy="13.5" r="1" fill="currentColor"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: remaining_icon, tone: :amber, label: "Remaining",
        value: usd(@calendar.remaining_cents), note: "#{@calendar.percent_of_income_left}% of income left" %>
</div>

<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_360px] gap-5">
  <div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-5">
    <div class="flex items-center justify-between gap-4 flex-wrap mb-4">
      <div class="flex items-center gap-4 text-xs text-gray-500">
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-600"></span> Income</span>
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500"></span> Expense</span>
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-gray-300"></span> No Activity</span>
      </div>

      <%= form_with url: budget_calendar_path, method: :get do %>
        <%= hidden_field_tag :period, @period %>
        <%= render "shared/filter_select", name: "month", options: @month_options, selected: @month.to_s, icon: true %>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <div class="min-w-[640px] border border-gray-200 rounded-xl overflow-hidden">
        <div class="grid grid-cols-7 bg-gray-50 border-b border-gray-200">
          <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %>
            <div class="px-3 py-3.5 text-center text-xs font-semibold text-gray-500"><%= day %></div>
          <% end %>
        </div>

        <% most_expensive = @calendar.most_expensive_day %>
        <% @calendar.weeks.each do |week| %>
          <div class="grid grid-cols-7 border-b border-gray-200 last:border-0">
            <% week.each do |day| %>
              <% outside = !@calendar.in_month?(day.date) %>
              <% biggest_spend = most_expensive && day.date == most_expensive.date %>
              <% tone = if outside then "bg-white"
                        elsif biggest_spend then "bg-red-50"
                        elsif day.income_cents.positive? then "bg-green-50"
                        else "bg-white" end %>
              <div class="min-h-[118px] px-3 py-2.5 border-r border-gray-100 last:border-r-0 <%= tone %>">
                <p class="text-sm font-semibold <%= outside ? "text-gray-300" : "text-gray-900" %>"><%= day.date.day %></p>

                <% unless outside %>
                  <div class="flex items-center gap-1 mt-1.5 h-2">
                    <% if day.activity? %>
                      <%# One dot per transaction, capped so a busy day can't overflow the cell. %>
                      <% [day.income_count, 3].min.times do %>
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                      <% end %>
                      <% [day.expense_count, 3].min.times do %>
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                      <% end %>
                    <% else %>
                      <span class="w-1.5 h-1.5 rounded-full bg-gray-200"></span>
                    <% end %>
                  </div>

                  <% if day.activity? %>
                    <p class="mt-1.5 text-xs font-semibold whitespace-nowrap <%= day.net_cents.negative? ? "text-red-500" : "text-green-600" %>">
                      <%= day.net_cents.negative? ? "−" : "+" %><%= usd(day.net_cents.abs) %>
                    </p>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-5 self-start">
    <h2 class="text-lg font-bold text-gray-900">Overview</h2>
    <p class="text-sm text-gray-400 mb-4">Here's how your budget is going.</p>

    <div class="flex items-center gap-1 border-b border-gray-100 mb-1">
      <% MonthlyCalendar::PERIODS.each do |period| %>
        <% active = @period == period %>
        <%= link_to period.capitalize, budget_calendar_path(month: @month.to_s, period: period),
              class: "px-3 py-2 text-sm font-semibold border-b-2 -mb-px #{active ? "border-green-700 text-green-800" : "border-transparent text-gray-400 hover:text-gray-600"}" %>
      <% end %>
    </div>
    <p class="text-xs text-gray-400 mb-4">
      <%= @range.first == @range.last ? l(@range.first, format: :long) : "#{@range.first.strftime("%b %-d")} – #{@range.last.strftime("%b %-d, %Y")}" %>
    </p>

    <dl class="space-y-3 pb-4 border-b border-gray-100">
      <div class="flex items-center justify-between gap-3">
        <dt class="text-sm text-gray-500">Total Income</dt>
        <dd class="font-extrabold text-gray-900"><%= usd(@totals[:income_cents]) %></dd>
      </div>
      <div class="flex items-center justify-between gap-3">
        <dt class="text-sm text-gray-500">Total Expenses</dt>
        <dd class="font-extrabold text-gray-900"><%= usd(@totals[:expense_cents]) %></dd>
      </div>
      <div class="flex items-center justify-between gap-3">
        <dt class="text-sm text-gray-500">Remaining</dt>
        <dd class="font-extrabold <%= @totals[:remaining_cents].negative? ? "text-red-500" : "text-gray-900" %>"><%= usd(@totals[:remaining_cents]) %></dd>
      </div>
    </dl>

    <div class="flex items-center justify-between gap-3 mt-4 mb-3">
      <h3 class="font-bold text-gray-900">Top Spending Categories</h3>
      <%= link_to "View All", reports_path, class: "text-sm font-bold text-green-700 hover:text-green-900" %>
    </div>

    <% if @top_categories.any? %>
      <ul class="space-y-3">
        <% @top_categories.each do |row| %>
          <li class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0" style="<%= category_badge_style(row.color) %>">
              <%= icon_svg(row.icon || "more-horizontal", class_name: "w-4 h-4") %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-semibold text-gray-900 truncate"><%= row.name %></span>
                <span class="text-sm font-bold text-gray-900 whitespace-nowrap"><%= usd(row.cents) %></span>
              </div>
              <div class="flex items-center gap-2 mt-1">
                <div class="flex-1 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                  <div class="h-full rounded-full" style="width: <%= [row.percent, 100].min %>%; background-color: <%= row.color || "#6b7280" %>"></div>
                </div>
                <span class="text-[11px] text-gray-400 whitespace-nowrap"><%= row.percent.round %>%</span>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-400 py-4">No spending in this period.</p>
    <% end %>

    <% if (day = @calendar.most_expensive_day) %>
      <%= link_to transactions_path(range: "all"), class: "flex items-center justify-between gap-3 border border-gray-200 rounded-xl px-4 py-3 mt-5 hover:bg-gray-50" do %>
        <div>
          <p class="text-sm font-semibold text-gray-900">Most Expensive Day</p>
          <p class="text-xs text-gray-400 mt-0.5">Total spent</p>
        </div>
        <div class="text-right">
          <p class="text-sm font-semibold text-gray-900"><%= day.date.strftime("%-d %B") %></p>
          <p class="text-sm font-bold text-red-500 mt-0.5"><%= usd(day.expense_cents) %></p>
        </div>
      <% end %>
    <% end %>

    <div class="bg-green-50 border border-green-100 rounded-xl px-4 py-3 mt-4">
      <p class="text-xs text-gray-600"><span class="font-bold text-gray-900">Tip:</span> <%= @insight.message %></p>
      <%= link_to "View Insights →", root_path, class: "inline-block mt-2 text-xs font-bold text-green-700 hover:text-green-900" %>
    </div>
  </div>
</div>
