<% content_for(:page_heading, "Dashboard") %>
<% content_for(:page_icon) do %>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
<% end %>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-6">
  <% money_left_icon = capture do %>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1h1a1 1 0 0 1 1 1v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7z"/><circle cx="16" cy="13" r="1" fill="currentColor" stroke="none"/></svg>
  <% end %>
  <%= render "shared/stat_card",
        icon: money_left_icon,
        label: "Money left to spend",
        value: usd(@summary.remaining_cents),
        note: "of #{usd(@summary.income_cents)} income",
        cta_label: "Add Transaction",
        cta_path: new_transaction_path, cta_frame: "modal" %>

  <% income_icon = capture do %>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg>
  <% end %>
  <%= render "shared/stat_card",
        icon: income_icon,
        label: "Income",
        value: usd(@summary.income_cents),
        note: "This month",
        cta_label: "Add Income",
        cta_path: new_transaction_path, cta_frame: "modal" %>

  <% budget_icon = capture do %>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l7.8 4.5"/></svg>
  <% end %>
  <%= render "shared/stat_card",
        icon: budget_icon,
        label: "Budget",
        value: usd(@summary.allocated_cents),
        note: "of #{usd(@summary.income_cents)} income",
        cta_label: "Edit Budget",
        cta_path: budget_path %>

  <% if @savings.goals.exists? %>
    <% goal_icon = capture do %>
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/></svg>
    <% end %>
    <%= render "shared/stat_card",
          icon: goal_icon,
          label: "Monthly Goal",
          value: "#{@savings.goals_percent_complete}%",
          note: "#{usd(@savings.goals_current_cents)} of #{usd(@savings.goals_target_cents)}",
          cta_label: "View Goals",
          cta_path: goals_path %>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-5 mb-6">
  <div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="font-bold text-gray-900">Budget Breakdown</h2>
      <%= link_to "View Full Report", reports_path, class: "text-sm font-bold text-green-700 hover:text-green-900" %>
    </div>

    <div class="flex flex-col xl:flex-row items-center gap-8">
      <div class="shrink-0 relative w-72 h-72">
        <%= pie_chart @summary.category_breakdown.map { |row| [row.category.name, row.spent_cents / 100.0] },
              donut: true,
              colors: @summary.category_breakdown.map { |row| row.category.color },
              library: { plugins: { legend: { display: false }, tooltip: { enabled: true } }, cutout: "70%" },
              height: "288px" %>
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
          <p class="text-3xl font-extrabold text-gray-900"><%= usd(@summary.spent_cents) %></p>
          <p class="text-xs text-gray-400">Spent</p>
        </div>
      </div>

      <div class="w-full border border-gray-200 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
        <%# Budget is the column to lose first: Spent and In % carry the meaning. %>
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 text-left text-gray-500 text-xs">
              <%# Category absorbs the slack; the rest hold a share so they stay
                  spread out instead of collapsing to content width on the right. %>
              <th class="font-semibold px-3 sm:px-4 py-3 w-[38%]">Category</th>
              <th class="font-semibold px-3 sm:px-4 py-3 w-[16%]">Spent</th>
              <th class="font-semibold px-4 py-3 hidden sm:table-cell lg:hidden xl:table-cell w-[16%]">Budget</th>
              <th class="font-semibold px-3 py-3 w-[30%]">In %</th>
            </tr>
          </thead>
          <tbody>
            <% @summary.category_breakdown.each do |row| %>
              <tr class="border-t border-gray-100">
                <td class="px-3 sm:px-4 py-2.5 max-w-0">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= row.category.color %>"></span>
                    <span class="truncate"><%= row.category.name %></span>
                  </div>
                </td>
                <td class="px-3 sm:px-4 py-2.5 whitespace-nowrap"><%= usd(row.spent_cents) %></td>
                <td class="px-4 py-2.5 whitespace-nowrap hidden sm:table-cell lg:hidden xl:table-cell"><%= usd(row.allocated_cents) %></td>
                <td class="px-3 py-2.5">
                  <div class="flex items-center gap-2">
                    <span class="text-gray-900"><%= row.percent %>%</span>
                    <div class="w-12 xl:w-16 h-1.5 rounded-full bg-gray-100 overflow-hidden shrink-0">
                      <div class="h-full rounded-full" style="width: <%= [row.percent, 100].min %>%; background-color: <%= row.category.color %>"></div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>

  <div data-controller="dismissible" class="bg-gradient-to-bl from-green-200 via-green-50 to-white border border-green-100 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-6 flex flex-col">
    <div class="flex items-center gap-2 mb-4">
      <svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 3l1.9 4.4L18 9l-4.1 1.6L12 15l-1.9-4.4L6 9l4.1-1.6z"/></svg>
      <h2 class="font-bold text-gray-900">Budget Insight</h2>
    </div>

    <p class="text-sm text-gray-700 mb-4"><%= @insight.message %></p>

    <div class="flex items-center gap-3 mb-4">
      <%= link_to "Review Budget", budget_path, class: "flex-1 text-center bg-green-700 text-white font-bold text-sm rounded-lg py-2 hover:bg-green-800" %>
      <button type="button" data-action="dismissible#dismiss" class="flex-1 text-center bg-white border border-green-600 text-green-700 font-bold text-sm rounded-lg py-2 hover:bg-green-50 cursor-pointer">Not Now</button>
    </div>

    <div class="flex-1 flex items-center justify-center min-h-0 py-2">
      <svg class="w-28 h-28" viewBox="0 0 100 100" fill="none">
        <ellipse cx="50" cy="93" rx="26" ry="4" fill="#166534" fill-opacity="0.08"/>
        <rect x="26" y="8" width="48" height="38" rx="16" fill="#f3f4f6" stroke="#9ca3af" stroke-width="2"/>
        <rect x="36" y="20" width="28" height="18" rx="9" fill="#14532d"/>
        <path d="M44 30l3.5-6 3.5 6z" fill="#4ade80"/>
        <path d="M53 30l3.5-6 3.5 6z" fill="#4ade80"/>
        <rect x="44" y="4" width="12" height="8" rx="4" fill="#9ca3af"/>
        <circle cx="50" cy="4" r="3.5" fill="#4ade80"/>
        <rect x="45" y="44" width="10" height="8" fill="#d1d5db"/>
        <rect x="22" y="50" width="56" height="40" rx="14" fill="#ffffff" stroke="#9ca3af" stroke-width="2"/>
        <rect x="34" y="60" width="32" height="14" rx="5" fill="#dcfce7"/>
        <circle cx="16" cy="68" r="8" fill="#f3f4f6" stroke="#9ca3af" stroke-width="2"/>
        <circle cx="84" cy="68" r="8" fill="#f3f4f6" stroke="#9ca3af" stroke-width="2"/>
        <circle cx="16" cy="68" r="3" fill="#16a34a"/>
        <circle cx="84" cy="68" r="3" fill="#16a34a"/>
      </svg>
    </div>

    <div class="bg-white border border-green-200 rounded-xl p-3 flex items-start gap-2 mt-auto">
      <div class="w-5 h-5 rounded-full bg-green-600 text-white flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4"/><circle cx="12" cy="8" r="0.5" fill="currentColor"/></svg>
      </div>
      <p class="text-xs text-gray-600"><span class="font-bold text-gray-800">Tip:</span> <%= @insight.tip %></p>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-bold text-gray-900">Recent Transactions</h2>
      <%= link_to "View All", transactions_path, class: "text-sm font-bold text-green-700 hover:text-green-900" %>
    </div>

    <div class="border border-gray-200 rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
      <%# Narrow screens shed Type then Date rather than scrolling sideways; the
          date reappears beside the category name below md. %>
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-left text-gray-500 text-xs">
            <%# Category absorbs the slack; the rest hold a share so they stay
                spread out instead of collapsing to content width on the right. %>
            <th class="font-semibold px-4 py-3 w-[41%]">Category</th>
            <th class="font-semibold px-4 py-3 hidden md:table-cell w-[19%]">Date</th>
            <th class="font-semibold px-4 py-3 hidden lg:table-cell w-[18%]">Type</th>
            <th class="font-semibold px-4 py-3 pr-6 text-right w-[22%]">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_transactions.each do |transaction| %>
            <tr class="border-t border-gray-100">
              <td class="px-4 py-3 max-w-0">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 <%= transaction.income? ? "bg-green-100 text-green-600" : "bg-red-100 text-red-500" %>">
                    <% if transaction.income? %>
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></svg>
                    <% else %>
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
                    <% end %>
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-gray-900 truncate"><%= transaction.description.presence || transaction.category&.name || "Uncategorized" %></p>
                    <p class="text-xs text-gray-400 truncate">
                      <%= transaction.category&.name || "Uncategorized" %>
                      <span class="md:hidden">· <%= transaction.date.strftime("%b %-d") %></span>
                    </p>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-gray-500 whitespace-nowrap hidden md:table-cell"><%= transaction.date.strftime("%m/%d/%Y") %></td>
              <td class="px-4 py-3 hidden lg:table-cell">
                <span class="inline-flex items-center gap-1.5 text-gray-500">
                  <span class="w-1.5 h-1.5 rounded-full <%= transaction.income? ? "bg-green-500" : "bg-red-500" %>"></span>
                  <%= transaction.transaction_type.capitalize %>
                </span>
              </td>
              <td class="px-4 py-3 pr-6 text-right font-semibold <%= transaction.income? ? "text-green-600" : "text-red-500" %>">
                <%= transaction.income? ? "+" : "-" %><%= usd(transaction.amount_cents) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-bold text-gray-900">Recent Achievements</h2>
      <%= link_to "View All", "#", class: "text-sm font-bold text-green-700 hover:text-green-900" %>
    </div>

    <div class="flex flex-col gap-3">
      <% @achievements.select(&:unlocked).each do |achievement| %>
        <%= render "shared/achievement_item", achievement: achievement %>
      <% end %>
    </div>
  </div>
</div>
