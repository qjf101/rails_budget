<h2 class="text-xl font-extrabold text-gray-900 mb-6">Forgot your password?</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="mb-6">
    <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600" %>
  </div>

  <div>
    <%= f.submit "Send me password reset instructions", class: "w-full bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg py-2.5 text-sm cursor-pointer" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
