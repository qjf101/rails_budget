<h2 class="text-xl font-extrabold text-gray-900 mb-6">Log in</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="mb-4">
    <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600" %>
  </div>

  <div class="mb-4">
    <%= f.label :password, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2 mb-6">
      <%= f.check_box :remember_me, class: "rounded border-gray-300 text-green-600 focus:ring-green-600" %>
      <%= f.label :remember_me, class: "text-sm text-gray-600" %>
    </div>
  <% end %>

  <div>
    <%= f.submit "Log in", class: "w-full bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg py-2.5 text-sm cursor-pointer" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
