<% withdrawing = @direction == "withdraw" %>
<% target = @goal&.name || "General Savings" %>
<% available = @goal ? @goal.current_cents : current_user.savings.unallocated_cents %>
<% field = "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600" %>
<% no_spinner = "[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" %>

<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 bg-black/30 flex items-start justify-center p-4 overflow-y-auto"
       data-controller="modal"
       data-action="click->modal#closeOnBackdrop keydown@window->modal#closeOnEscape">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm my-10">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-lg font-bold text-gray-900"><%= withdrawing ? "Withdraw" : "Add Funds" %></h2>
          <p class="text-xs text-gray-400 mt-0.5"><%= target %> · <%= usd(available) %> available</p>
        </div>
        <button type="button" data-action="modal#close" class="text-gray-400 hover:text-gray-600 cursor-pointer" aria-label="Close">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <%= form_with model: @contribution,
            url: @goal ? goal_contributions_path(@goal, direction: @direction) : contributions_path(direction: @direction),
            method: :post do |form| %>
        <div class="p-6 space-y-4">
          <% if @contribution.errors.any? %>
            <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
              <ul class="list-disc list-inside space-y-0.5">
                <% @contribution.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= form.label :amount, "Amount", class: "block text-xs font-bold text-gray-700 mb-1.5" %>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-gray-400">$</span>
              <%= form.number_field :amount, value: nil, step: "0.01", min: 0, placeholder: "0.00", autofocus: true,
                    class: "#{field} pl-7 #{no_spinner}" %>
            </div>
          </div>

          <div>
            <%= form.label :note, "Note (optional)", class: "block text-xs font-bold text-gray-700 mb-1.5" %>
            <%= form.text_field :note, placeholder: withdrawing ? "What's it for?" : "Where did it come from?", class: field %>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100">
          <button type="button" data-action="modal#close" class="rounded-lg border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 cursor-pointer">Cancel</button>
          <%= form.submit withdrawing ? "Withdraw" : "Add Funds",
                class: "rounded-lg #{withdrawing ? "bg-gray-900 hover:bg-black" : "bg-green-800 hover:bg-green-900"} px-5 py-2.5 text-sm font-bold text-white cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
