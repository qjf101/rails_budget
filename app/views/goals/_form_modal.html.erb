<%# locals: goal, title, submit_label, url, method %>
<% field = "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600" %>
<% label_classes = "block text-xs font-bold text-gray-700 mb-1.5" %>
<% no_spinner = "[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" %>

<div class="fixed inset-0 z-50 bg-black/30 flex items-start justify-center p-4 overflow-y-auto"
     data-controller="modal"
     data-action="click->modal#closeOnBackdrop keydown@window->modal#closeOnEscape">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md my-10">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900"><%= title %></h2>
      <button type="button" data-action="modal#close" class="text-gray-400 hover:text-gray-600 cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <%= form_with model: goal, url: url, method: method do |form| %>
      <div class="p-6 space-y-5">
        <% if goal.errors.any? %>
          <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
            <ul class="list-disc list-inside space-y-0.5">
              <% goal.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :name, "Goal Name", class: label_classes %>
          <%= form.text_field :name, placeholder: "e.g. Emergency Fund", autofocus: true, class: field %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :target, "Target Amount", class: label_classes %>
            <%= form.number_field :target, value: goal.target, step: "0.01", min: 0, placeholder: "0.00", class: "#{field} #{no_spinner}" %>
          </div>
          <div>
            <%= form.label :target_date, "Target Date", class: label_classes %>
            <%= form.date_field :target_date, class: field %>
          </div>
        </div>

        <div>
          <span class="<%= label_classes %>">Icon</span>
          <div data-controller="swatch" data-swatch-name-value="icon">
            <%= form.hidden_field :icon, data: { swatch_target: "input" } %>
            <div class="grid grid-cols-9 gap-1.5">
              <% Iconable::ICON_KEYS.each do |key| %>
                <button type="button" data-action="swatch#select" data-value="<%= key %>" data-swatch-target="option"
                        class="aspect-square rounded-lg border flex items-center justify-center cursor-pointer <%= goal.icon == key ? "border-green-600 bg-green-50 text-green-700" : "border-gray-200 text-gray-500 hover:bg-gray-50" %>"
                        aria-label="<%= key.humanize %>">
                  <%= icon_svg(key, class_name: "w-4 h-4 pointer-events-none") %>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div>
          <span class="<%= label_classes %>">Color</span>
          <div data-controller="swatch" data-swatch-name-value="color">
            <%= form.hidden_field :color, data: { swatch_target: "input" } %>
            <div class="flex items-center gap-2 flex-wrap">
              <% GoalsController::PALETTE.each do |hex| %>
                <button type="button" data-action="swatch#select" data-value="<%= hex %>" data-swatch-target="option"
                        class="w-8 h-8 rounded-full cursor-pointer <%= goal.color == hex ? "ring-2 ring-offset-2 ring-gray-900" : "" %>"
                        style="background-color: <%= hex %>" aria-label="<%= hex %>"></button>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100">
        <button type="button" data-action="modal#close" class="rounded-lg border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 cursor-pointer">Cancel</button>
        <%= form.submit submit_label, class: "rounded-lg bg-green-800 px-5 py-2.5 text-sm font-bold text-white hover:bg-green-900 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
