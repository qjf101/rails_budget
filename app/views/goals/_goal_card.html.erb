<%# locals: goal %>
<% percent = goal.percent_complete %>
<% color = goal.color.presence || "#3b82f6" %>

<div class="group relative bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-5">
  <div class="flex items-start gap-3 mb-4 pr-5">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="<%= category_badge_style(color) %>">
      <%= icon_svg(goal.icon || "target", class_name: "w-5 h-5") %>
    </div>
    <p class="min-w-0 font-bold text-gray-900 truncate mt-1.5"><%= goal.name %></p>

    <% if goal.completed? %>
      <span class="inline-flex items-center gap-1 bg-green-50 text-green-700 text-xs font-bold rounded-full px-2.5 py-1 shrink-0 mt-1">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        Complete
      </span>
    <% end %>
  </div>

  <%# Absolutely placed so the invisible button never narrows the goal name. %>
  <div class="absolute top-4 right-3 opacity-0 focus-within:opacity-100 group-hover:opacity-100 transition-opacity"
       data-controller="dropdown" data-action="click@window->dropdown#hide">
    <button type="button" data-action="dropdown#toggle" class="text-gray-300 hover:text-gray-600 p-1 rounded-md cursor-pointer" aria-label="More options">
      <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
    </button>
    <div data-dropdown-target="menu" class="hidden absolute right-0 top-full mt-1 z-20 w-32 bg-white border border-gray-200 rounded-lg shadow-lg py-1 text-left">
      <%= link_to "Edit", edit_goal_path(goal), data: { turbo_frame: "modal" }, class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
      <%= link_to "Delete", goal_path(goal),
            data: { turbo_method: :delete, turbo_confirm: "Delete \"#{goal.name}\"? Its contributions go back to General Savings." },
            class: "block px-3 py-2 text-sm text-red-600 hover:bg-red-50" %>
    </div>
  </div>

  <div class="flex items-baseline justify-between gap-3">
    <p class="text-2xl font-extrabold text-gray-900"><%= usd(goal.current_cents) %></p>
    <p class="text-sm text-gray-400 whitespace-nowrap">of <%= usd(goal.target_cents) %></p>
  </div>

  <div class="h-2 rounded-full overflow-hidden mt-2.5" style="background-color: <%= color %>26">
    <div class="h-full rounded-full" style="width: <%= percent.clamp(0, 100) %>%; background-color: <%= color %>"></div>
  </div>

  <div class="flex items-center justify-between gap-3 mt-2">
    <span class="text-xs font-bold" style="color: <%= color %>"><%= percent %>% funded</span>
    <span class="text-xs text-gray-400 whitespace-nowrap">
      <% if goal.completed? %>
        Reached <%= goal.completed_at.strftime("%b %Y") %>
      <% elsif goal.target_date %>
        Target: <%= goal.target_date.strftime("%b %-d, %Y") %>
      <% else %>
        No target date
      <% end %>
    </span>
  </div>

  <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-gray-100">
    <%= link_to new_goal_contribution_path(goal, direction: "add"), data: { turbo_frame: "modal" },
          class: "inline-flex items-center justify-center gap-1.5 bg-green-50 text-green-700 font-bold text-xs rounded-lg py-2.5 hover:bg-green-100" do %>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Funds
    <% end %>

    <%= link_to new_goal_contribution_path(goal, direction: "withdraw"), data: { turbo_frame: "modal" },
          class: "inline-flex items-center justify-center gap-1.5 bg-white border border-gray-200 text-gray-700 font-bold text-xs rounded-lg py-2.5 hover:bg-gray-50" do %>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Withdraw
    <% end %>

    <%= link_to new_goal_transfer_path(from_goal_id: goal.id), data: { turbo_frame: "modal" },
          class: "inline-flex items-center justify-center gap-1.5 bg-white border border-gray-200 text-gray-700 font-bold text-xs rounded-lg py-2.5 hover:bg-gray-50" do %>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13"/><path d="M14 5l3 3-3 3"/><path d="M20 16H7"/><path d="M10 13l-3 3 3 3"/></svg>
      Transfer
    <% end %>
  </div>
</div>
