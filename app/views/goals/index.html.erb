<% content_for(:page_heading, "Goals") %>
<% content_for(:page_icon) do %>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/></svg>
<% end %>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 mb-5">
  <% saved_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 6.5H9.5a3 3 0 000 6h5a3 3 0 010 6H6"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: saved_icon, tone: :green, label: "Total Saved",
        value: usd(@savings.current_cents), note: "across #{pluralize(@goals.size, "goal")}" %>

  <% active_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: active_icon, tone: :blue, label: "Active Goals",
        value: @active_goals.size.to_s, note: "In progress", note_tone: :info %>

  <% done_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: done_icon, tone: :amber, label: "Completed",
        value: @completed_goals.size.to_s, note: pluralize(@completed_goals.size, "goal") + " reached" %>
</div>

<div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-5 mb-6">
  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-10 h-10 rounded-xl bg-gray-100 text-gray-500 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 6.5H9.5a3 3 0 000 6h5a3 3 0 010 6H6"/></svg>
      </div>
      <div class="min-w-0">
        <p class="font-bold text-gray-900">General Savings</p>
        <p class="text-xs text-gray-400">Not yet assigned to a goal</p>
      </div>
    </div>

    <div class="flex items-center gap-3 flex-wrap">
      <p class="text-xl font-extrabold text-gray-900"><%= usd(@savings.unallocated_cents) %></p>

      <%= link_to new_contribution_path(direction: "add"), data: { turbo_frame: "modal" },
            class: "inline-flex items-center gap-1.5 bg-green-50 text-green-700 font-bold text-xs rounded-lg px-3.5 py-2.5 hover:bg-green-100" do %>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Funds
      <% end %>

      <% if @goals.any? %>
        <%= link_to new_goal_transfer_path, data: { turbo_frame: "modal" },
              class: "inline-flex items-center gap-1.5 bg-white border border-gray-200 text-gray-700 font-bold text-xs rounded-lg px-3.5 py-2.5 hover:bg-gray-50" do %>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
          Assign to Goal
        <% end %>
      <% end %>

      <%= link_to new_contribution_path(direction: "withdraw"), data: { turbo_frame: "modal" },
            class: "inline-flex items-center gap-1.5 bg-white border border-gray-200 text-gray-700 font-bold text-xs rounded-lg px-3.5 py-2.5 hover:bg-gray-50" do %>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Withdraw
      <% end %>
    </div>
  </div>
</div>

<h2 class="font-bold text-gray-900 mb-3">Your Goals</h2>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
  <% @goals.each do |goal| %>
    <%= render "goal_card", goal: goal %>
  <% end %>

  <%= link_to new_goal_path, data: { turbo_frame: "modal" },
        class: "border-2 border-dashed border-gray-200 rounded-2xl p-6 flex flex-col items-center justify-center text-center gap-2 min-h-[200px] hover:border-green-600 hover:bg-green-50/40" do %>
    <span class="w-10 h-10 rounded-full border-2 border-green-600 text-green-700 flex items-center justify-center">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </span>
    <span class="font-bold text-gray-900">Add New Goal</span>
    <span class="text-xs text-gray-400">Set a target and we'll track your progress.</span>
  <% end %>
</div>
