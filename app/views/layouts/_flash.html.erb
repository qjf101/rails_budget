<%# Several controllers already set flashes; without this nothing rendered them. %>
<% if flash.any? %>
  <div class="fixed top-20 right-4 sm:right-6 z-40 space-y-2 w-full max-w-sm pointer-events-none">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <% tone = type.to_s == "alert" ? "bg-red-50 border-red-200 text-red-800" : "bg-white border-gray-200 text-gray-900" %>
      <div data-controller="dismissible"
           class="pointer-events-auto flex items-start gap-3 border rounded-xl shadow-lg px-4 py-3 <%= tone %>">
        <% if type.to_s == "alert" %>
          <svg class="w-4 h-4 text-red-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>
        <% else %>
          <svg class="w-4 h-4 text-green-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        <% end %>
        <p class="text-sm flex-1"><%= message %></p>
        <button type="button" data-action="dismissible#dismiss" class="text-gray-400 hover:text-gray-600 cursor-pointer shrink-0" aria-label="Dismiss">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
