<div data-sidebar-target="panel" class="fixed inset-y-0 left-0 z-40 -translate-x-full transition-transform duration-200 lg:translate-x-0 lg:static w-60 shrink-0 bg-gray-50 border-r border-gray-200 flex flex-col p-4 overflow-y-auto">

  <div class="flex items-center gap-2 px-2 pb-12">
    <div class="w-8 h-8 rounded-lg bg-green-600 flex items-center justify-center">
      <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15l6-6 4 4 6-8"/><path d="M15 5h5v5"/></svg>
    </div>
    <span class="text-lg font-extrabold text-green-700">budget app</span>
  </div>

  <nav class="flex flex-col gap-1.5">
    <%= link_to root_path, class: nav_link_classes(root_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>Dashboard</span>
    <% end %>

    <%= link_to transactions_path, class: nav_link_classes(transactions_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13"/><path d="M14 4l3 3-3 3"/><path d="M20 17H7"/><path d="M10 14l-3 3 3 3"/></svg>
      <span>Transactions</span>
    <% end %>

    <%= link_to budget_path, class: nav_link_classes(budget_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5V5a1 1 0 0 1 1-1h6.5a1 1 0 0 1 .7.3l8.5 8.5a1 1 0 0 1 0 1.4l-6.5 6.5a1 1 0 0 1-1.4 0L3.3 12.2a1 1 0 0 1-.3-.7z"/><circle cx="7.5" cy="7.5" r="1.3" fill="currentColor" stroke="none"/></svg>
      <span>Budget</span>
    <% end %>

    <%= link_to budget_calendar_path, class: nav_link_classes(budget_calendar_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/></svg>
      <span>Calender</span>
    <% end %>

    <%= link_to goals_path, class: nav_link_classes(goals_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/></svg>
      <span>Goals</span>
    <% end %>

    <%= link_to reports_path, class: nav_link_classes(reports_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="20" y2="20"/><rect x="6" y="12" width="3.5" height="8"/><rect x="11" y="7" width="3.5" height="13"/><rect x="16" y="15" width="3.5" height="5"/></svg>
      <span>Reports</span>
    <% end %>

    <%= link_to settings_path, class: nav_link_classes(settings_path) do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="9" cy="7" r="1.6" fill="currentColor" stroke="none"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="15" cy="12" r="1.6" fill="currentColor" stroke="none"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="11" cy="17" r="1.6" fill="currentColor" stroke="none"/></svg>
      <span>Settings</span>
    <% end %>
  </nav>

  <div class="flex-grow"></div>

  <div class="bg-green-50 rounded-2xl p-4 mb-4">
    <p class="text-[11px] font-bold text-green-800 mb-1.5">KEEP GOING</p>
    <p class="text-xs text-gray-600 leading-relaxed mb-3">Small, steady progress beats big irregular pushes.</p>
    <%= link_to "View Progress ->", "#", class: "text-sm font-bold text-green-700 hover:text-green-900" %>
  </div>

  <div class="flex items-center gap-2.5 p-2">
    <div class="w-8 h-8 rounded-full bg-gray-300"></div>
    <div>
      <p class="text-sm font-bold text-gray-900"><%= current_user.email %></p>
      <p class="text-xs text-gray-400">Basic Plan</p>
    </div>
  </div>

</div>
