<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="bg-gray-50">
    <div class="flex h-screen overflow-hidden" data-controller="sidebar">
      <div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="hidden fixed inset-0 bg-black/30 z-30 lg:hidden"></div>

      <%= render "layouts/sidebar" %>

      <div class="flex-1 flex flex-col min-w-0 min-h-0">
        <%= render "layouts/topbar" %>

        <main class="p-4 sm:p-6 lg:p-8 bg-white flex-1 overflow-y-auto">
          <%= yield %>
        </main>
      </div>
    </div>

    <%= render "layouts/flash" %>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
