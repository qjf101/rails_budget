<%# locals: notifications. Rendered into the lazy frame when the bell is opened. %>
<%= turbo_frame_tag "notifications_menu" do %>
  <div class="flex items-center justify-between gap-3 px-4 py-2.5 border-b border-gray-100">
    <p class="text-sm font-bold text-gray-900">Notifications</p>
    <% if notifications.any? { |n| !n.read? } %>
      <%# _top: without it these navigate the dropdown frame instead of the page. %>
      <%= button_to "Mark all read", read_all_notifications_path,
            form: { data: { turbo_frame: "_top" } },
            class: "text-xs font-semibold text-green-700 hover:text-green-900 bg-transparent border-0 cursor-pointer p-0" %>
    <% end %>
  </div>

  <% if notifications.any? %>
    <ul class="max-h-80 overflow-y-auto divide-y divide-gray-100">
      <% notifications.each do |notification| %>
        <li>
          <%# Straight to the destination: a redirect here triggers a second Turbo
              render that blanks any canvas on the target page. %>
          <%= link_to notification.url.presence || root_path, data: { turbo_frame: "_top" },
                class: "flex items-start gap-2.5 px-4 py-3 hover:bg-gray-50 #{"bg-green-50/50" unless notification.read?}" do %>
            <span class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 <%= notification.read? ? "bg-transparent" : "bg-green-600" %>"></span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-gray-900 truncate"><%= notification.title %></span>
              <% if notification.body.present? %>
                <span class="block text-xs text-gray-500 mt-0.5"><%= notification.body %></span>
              <% end %>
              <span class="block text-xs text-gray-400 mt-1"><%= time_ago_in_words(notification.created_at) %> ago</span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-4 py-8 text-center text-sm text-gray-400">Nothing yet.</p>
  <% end %>

  <%# Stream elements run their action the moment they are connected to the DOM,
      so this rides along inside the frame response and refreshes the badge. %>
  <%= turbo_stream.replace "notifications_badge" do %>
    <%= render "layouts/notification_badge" %>
  <% end %>
<% end %>
