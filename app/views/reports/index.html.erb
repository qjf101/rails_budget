<% content_for(:page_heading, "Reports") %>
<% content_for(:page_icon) do %>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
<% end %>

<%= form_with url: reports_path, method: :get, class: "flex justify-end mb-5" do %>
  <%= render "shared/filter_select", name: "range", options: @range_options, selected: @range_key, icon: true %>
<% end %>

<% range_label = "#{@range.first.strftime("%b %-d")} – #{@range.last.strftime("%b %-d, %Y")}" %>
<% range_name = @range_options.find { |_, key| key == @range_key }&.first %>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 mb-5">
  <% income_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 6.5H9.5a3 3 0 000 6h5a3 3 0 010 6H6"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: income_icon, tone: :green, label: "Total Income",
        value: usd(@income_cents, precision: 2), note: range_name %>

  <% expense_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M6 13l6 6 6-6"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: expense_icon, tone: :red, label: "Total Expenses",
        value: usd(@expense_cents, precision: 2), note: range_name %>

  <% net_icon = capture do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13a3 3 0 013 3v5a3 3 0 01-3 3H6a2 2 0 01-2-2z"/><path d="M4 8V7a2 2 0 012-2h9"/><circle cx="16.5" cy="13.5" r="1" fill="currentColor"/></svg>
  <% end %>
  <%= render "shared/summary_card", icon: net_icon, tone: :blue, label: "Net Savings",
        value: usd(@net_cents, precision: 2), note: "#{@saved_percent}% of income saved", note_tone: :info %>
</div>

<div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-6 mb-5">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
    <div>
      <h2 class="text-lg font-bold text-gray-900">Income vs. Expenses</h2>
      <p class="text-sm text-gray-400 mt-0.5"><%= range_label %></p>
    </div>
    <div class="flex items-center gap-4 text-xs text-gray-500">
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-600"></span> Income</span>
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500"></span> Expenses</span>
    </div>
  </div>

  <%= column_chart @chart_series,
        colors: ["#16a34a", "#ef4444"],
        height: "300px",
        library: {
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { border: { display: false }, grid: { color: "#f3f4f6" } },
          },
        },
        prefix: "$" %>
</div>

<div class="bg-white border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-6">
  <h2 class="text-lg font-bold text-gray-900">Spending by Category</h2>
  <p class="text-sm text-gray-400 mt-0.5 mb-5"><%= range_label %></p>

  <% if @categories.any? %>
    <div class="flex flex-col lg:flex-row items-center gap-8">
      <div class="shrink-0 relative w-56 h-56">
        <%= pie_chart @categories.map { |row| [row.name, row.cents / 100.0] },
              donut: true,
              colors: @categories.map { |row| row.color },
              library: { plugins: { legend: { display: false }, tooltip: { enabled: true } }, cutout: "70%" },
              height: "224px" %>
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
          <p class="text-2xl font-extrabold text-gray-900"><%= usd(@expense_cents) %></p>
          <p class="text-xs text-gray-400">Spent</p>
        </div>
      </div>

      <ul class="w-full space-y-3">
        <% @categories.each do |row| %>
          <li class="flex items-center justify-between gap-3 text-sm">
            <span class="flex items-center gap-2.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: <%= row.color %>"></span>
              <span class="text-gray-700 truncate"><%= row.name %></span>
            </span>
            <span class="flex items-baseline gap-2 shrink-0">
              <span class="font-bold text-gray-900 whitespace-nowrap"><%= usd(row.cents, precision: 2) %></span>
              <span class="text-xs text-gray-400 w-12 text-right"><%= row.percent %>%</span>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p class="text-center text-gray-400 py-12">No spending in this period.</p>
  <% end %>
</div>
