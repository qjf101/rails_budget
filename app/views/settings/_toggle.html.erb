<%# locals: title, description, checked. UI only — nothing is persisted yet. %>
<div class="flex items-center justify-between gap-4 py-3.5">
  <div class="min-w-0">
    <p class="text-sm font-semibold text-gray-900"><%= title %></p>
    <p class="text-xs text-gray-400 mt-0.5"><%= description %></p>
  </div>

  <label class="relative inline-flex items-center cursor-pointer shrink-0">
    <input type="checkbox" class="sr-only peer" <%= "checked" if checked %> aria-label="<%= title %>">
    <span class="w-11 h-6 rounded-full bg-gray-200 peer-checked:bg-green-600 transition-colors"></span>
    <span class="absolute left-0.5 w-5 h-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
  </label>
</div>
