<%# locals: icon (svg markup, rendered via `capture`), label, value, note, cta_label, cta_path %>
<div class="bg-gray-50 border border-gray-200 rounded-2xl shadow-[0_1px_2px_rgba(0,0,0,0.04)] p-5">
  <div class="flex items-center gap-3 mb-4">
    <div class="w-12 h-12 rounded-full bg-green-600 text-white flex items-center justify-center shrink-0">
      <%= icon %>
    </div>
    <div class="flex flex-col justify-between gap-2.5">
      <p class="text-sm text-gray-600 leading-none"><%= label %></p>
      <p class="text-xl font-extrabold text-gray-900 leading-none"><%= value %></p>
      <p class="flex items-center gap-1.5 text-xs text-gray-400 leading-none">
        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><circle cx="12" cy="16" r="0.5" fill="currentColor"/></svg>
        <%= note %>
      </p>
    </div>
  </div>

  <%= link_to cta_label, cta_path, class: "block text-center bg-white border border-green-600 text-green-700 font-bold text-sm rounded-lg py-2 hover:bg-green-50" %>
</div>
