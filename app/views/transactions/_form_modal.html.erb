<%# locals: transaction, title, submit_label, url, method %>
<% field_classes = "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600" %>
<% label_classes = "block text-xs font-bold text-gray-700 mb-1.5" %>
<%# Number inputs carry spinner arrows the design doesn't have. %>
<% no_spinner = "[appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" %>

<div class="fixed inset-0 z-50 bg-black/30 flex items-start justify-center p-4 overflow-y-auto"
     data-controller="modal"
     data-action="click->modal#closeOnBackdrop keydown@window->modal#closeOnEscape">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg my-10"
       data-controller="transaction-form"
       data-transaction-form-savings-category-id-value="<%= savings_category&.id %>">

    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-bold text-gray-900"><%= title %></h2>
      <button type="button" data-action="modal#close" class="text-gray-400 hover:text-gray-600 cursor-pointer" aria-label="Close">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <%= form_with model: transaction, url: url, method: method do |form| %>
      <div class="p-6 space-y-4">
        <% if transaction.errors.any? %>
          <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
            <ul class="list-disc list-inside space-y-0.5">
              <% transaction.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :date, class: label_classes %>
            <%= form.date_field :date, class: field_classes %>
          </div>
          <div>
            <%= form.label :amount, class: label_classes %>
            <%= form.number_field :amount, value: transaction.amount, step: "0.01", min: 0, placeholder: "0.00",
                  class: "#{field_classes} #{no_spinner}",
                  data: { transaction_form_target: "amount", action: "input->transaction-form#recalculate" } %>
          </div>
        </div>

        <div>
          <%= form.label :description, class: label_classes %>
          <%= form.text_field :description, placeholder: "What was this for?", class: field_classes %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :category_id, "Category", class: label_classes %>
            <div class="relative">
              <%# The type tag on each option is what lets the Expense/Income toggle narrow this list. %>
              <% category_options = @categories.map { |c| [c.name, c.id, { "data-category-type" => c.category_type }] } %>
              <%= form.select :category_id,
                    options_for_select(category_options, transaction.category_id),
                    { include_blank: "Uncategorized" },
                    class: "#{field_classes} appearance-none pr-10 cursor-pointer",
                    data: { transaction_form_target: "category", action: "change->transaction-form#toggleSavings" } %>
              <svg class="w-4 h-4 text-gray-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>

          <div>
            <span class="<%= label_classes %>">Type</span>
            <%= form.hidden_field :transaction_type, data: { transaction_form_target: "typeInput" } %>
            <div class="flex items-center bg-gray-100 rounded-lg p-1">
              <% Transaction.transaction_types.keys.each do |type| %>
                <% active = transaction.transaction_type.to_s == type %>
                <button type="button" data-type="<%= type %>"
                        data-transaction-form-target="typeButton"
                        data-action="transaction-form#selectType"
                        class="flex-1 rounded-md py-2 text-sm font-bold cursor-pointer <%= active ? "bg-green-800 text-white" : "text-gray-500" %>">
                  <%= type.capitalize %>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <% if @goals.present? %>
          <div data-transaction-form-target="savingsSection" hidden class="pt-2 border-t border-gray-100">
            <h3 class="text-sm font-bold text-gray-900 mt-4">Split across goals</h3>
            <p class="text-xs text-gray-400 mt-1 mb-4">
              This is a Savings transaction — optionally divide it between your goals. Anything left over goes to general savings.
            </p>

            <div class="space-y-3">
              <% @goals.each do |goal| %>
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="<%= category_badge_style(goal.color) %>">
                    <%= icon_svg(goal.icon || "target", class_name: "w-4 h-4") %>
                  </div>
                  <span class="flex-1 text-sm text-gray-900 truncate"><%= goal.name %></span>
                  <div class="relative w-36 shrink-0">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-gray-400">$</span>
                    <%= number_field_tag "goal_allocations[#{goal.id}]", @goal_allocations[goal.id.to_s], step: "0.01", min: 0, placeholder: "0.00",
                          class: "w-full rounded-lg border border-gray-200 bg-gray-50 pl-7 pr-3 py-2 text-sm text-right text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-600 focus:border-green-600 #{no_spinner}",
                          data: { transaction_form_target: "allocation", action: "input->transaction-form#recalculate" } %>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="flex items-center justify-between rounded-lg bg-green-50 px-4 py-3 mt-4 text-sm font-bold text-green-800">
              <span>Unallocated → General Savings</span>
              <span data-transaction-form-target="unallocated">$0.00</span>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100">
        <button type="button" data-action="modal#close" class="rounded-lg border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 cursor-pointer">Cancel</button>
        <%= form.submit submit_label, class: "rounded-lg bg-green-800 px-5 py-2.5 text-sm font-bold text-white hover:bg-green-900 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
